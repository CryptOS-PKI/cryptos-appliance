# CryptOS platform profile: Proxmox VE virtual hardware.
#
# Additive fragment merged onto build/kernel/cryptos.config by build.sh when
# PLATFORM=proxmox. Proxmox runs QEMU with OVMF and swtpm, so the base already
# holds virtio-pci, virtio-net, virtio-blk and both TPM interfaces. This adds
# what a Proxmox VM presents beyond them. Keep MODULES=n: every driver is
# built in.

# Disk controllers. Proxmox defaults to VirtIO SCSI, with VirtIO Block, SATA
# and NVMe as the other choices on a VM's disk.
CONFIG_SCSI=y
CONFIG_SCSI_LOWLEVEL=y
CONFIG_SCSI_VIRTIO=y
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_NVME=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y

# CD-ROM / ISO boot support. A Proxmox CD is an IDE drive: AHCI on a q35 VM,
# PIIX on an i440fx VM. ISO9660_FS lets LocateBootUKI read cryptos.uki from it.
CONFIG_ATA_PIIX=y
CONFIG_BLK_DEV_SR=y
CONFIG_ISO9660_FS=y

# NICs beyond virtio-net, the other two models Proxmox offers that a modern
# guest would pick.
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000=y
CONFIG_E1000E=y

# The virtio-serial channel the QEMU guest agent talks over, and the VirtIO
# RNG device Proxmox can attach.
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM_VIRTIO=y

# PS/2 keyboard, for the noVNC console's Send Ctrl+Alt+Delete: the kernel
# hands it to PID 1 as SIGINT for an orderly reboot.
CONFIG_INPUT_KEYBOARD=y
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_KEYBOARD_ATKBD=y
