# CryptOS platform profile: physical servers.
#
# Additive fragment merged onto build/kernel/cryptos.config by build.sh when
# PLATFORM=baremetal. There are no hypervisor guest tools here, and the kernel
# has no loadable modules, so the storage and NIC drivers common server
# hardware needs are all built in. A NIC whose driver needs firmware files
# from /lib/firmware is left out or runs without them: the rootfs carries none.

# PCI Express: MSI interrupts and the port services. Several server NIC and
# RAID drivers depend on MSI.
CONFIG_PCI_MSI=y
CONFIG_PCIEPORTBUS=y

# Local disks: NVMe and SATA.
CONFIG_BLK_DEV_NVME=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_ATA_PIIX=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y

# RAID and SAS controllers: Broadcom/LSI HBAs and MegaRAID (Dell PERC, Lenovo
# ThinkSystem), HPE Smart Array, Microchip/Adaptec.
CONFIG_SCSI_LOWLEVEL=y
CONFIG_SCSI_MPT3SAS=y
CONFIG_MEGARAID_SAS=y
CONFIG_SCSI_SMARTPQI=y
CONFIG_SCSI_HPSA=y
CONFIG_SCSI_AACRAID=y

# Install media: an optical drive, or a BMC's virtual media, which a server
# presents as a USB CD-ROM. ISO9660_FS lets LocateBootUKI read cryptos.uki.
CONFIG_BLK_DEV_SR=y
CONFIG_ISO9660_FS=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_PCI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_PCI=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y

# NICs: Intel 1G to 100G, Broadcom, Mellanox and Realtek.
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000E=y
CONFIG_IGB=y
CONFIG_IGC=y
CONFIG_IXGBE=y
CONFIG_I40E=y
CONFIG_ICE=y
CONFIG_NET_VENDOR_BROADCOM=y
CONFIG_TIGON3=y
CONFIG_BNXT=y
CONFIG_NET_VENDOR_MELLANOX=y
CONFIG_MLX4_EN=y
CONFIG_MLX5_CORE=y
CONFIG_MLX5_CORE_EN=y
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_R8169=y

# Keyboards for the local console and the BMC's remote console: PS/2 and USB.
CONFIG_INPUT_KEYBOARD=y
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_HID_SUPPORT=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
