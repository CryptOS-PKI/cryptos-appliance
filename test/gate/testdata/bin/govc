#!/usr/bin/env bash
# Stand-in govc for run_test.sh. It logs every call (arguments and the
# connection settings it was handed, never the password itself) to
# $FAKE_STATE/govc.log and keeps just enough VM state for the fake
# cryptosctl: which ISO each VM boots, and power cuts.
set -euo pipefail
s="${FAKE_STATE:?}"
{
  printf 'ARGS'
  printf ' <%s>' "$@"
  printf '\n'
  printf 'ENV url=%s user_set=%s pass_set=%s insecure=%s known_hosts=%s\n' \
    "${GOVC_URL:-}" "${GOVC_USERNAME:+yes}" "${GOVC_PASSWORD:+yes}" "${GOVC_INSECURE:-}" "${GOVC_TLS_KNOWN_HOSTS:-}"
} >> "$s/govc.log"

role_of() { printf '%s\n' "${1##*-}"; }
last() { printf '%s\n' "${@: -1}"; }

cmd="$1"
shift
case "$cmd" in
  vm.create)
    name="$(last "$@")"
    role="$(role_of "$name")"
    iso=""
    while [ $# -gt 0 ]; do
      [ "$1" = -iso ] && iso="$2"
      shift
    done
    mkdir -p "$s/node-$role"
    printf '%s\n' "${iso##*/}" > "$s/node-$role/iso"
    printf '%s\n' "$name" >> "$s/vms"
    ;;
  vm.power)
    mode="$1"
    name="$(last "$@")"
    d="$s/node-$(role_of "$name")"
    if [ "$mode" = -off ]; then
      : > "$d/off"
    else
      rm -f "$d/off"
      if [ -f "$d/installed" ]; then
        echo $(( $(cat "$d/boots") + 1 )) > "$d/boots"
        cp "$d/next" "$d/running"
      fi
    fi
    ;;
  vm.ip)
    name="$(last "$@")"
    role="$(role_of "$name")"
    if [ -n "${FAKE_NO_IP_ROLE:-}" ] && [ "$role" = "$FAKE_NO_IP_ROLE" ]; then
      exit 0
    fi
    case "$role" in
      root) echo 198.51.100.11 ;;
      intermediate) echo 198.51.100.12 ;;
      fresh) echo 198.51.100.13 ;;
    esac
    ;;
  vm.destroy)
    printf '%s\n' "$(last "$@")" >> "$s/destroyed"
    ;;
  find)
    if [ -f "$s/vms" ] && [ -f "$s/destroyed" ]; then
      grep -vxF -f "$s/destroyed" "$s/vms" || true
    elif [ -f "$s/vms" ]; then
      cat "$s/vms"
    fi
    ;;
  datastore.mkdir | datastore.upload | datastore.rm | device.boot | device.serial.add | device.serial.connect | device.cdrom.eject) ;;
  *)
    echo "fake govc: unexpected command $cmd" >&2
    exit 1
    ;;
esac
