#!/usr/bin/env bash
# Stand-in `ip` for network_test.sh and run_test.sh: reports the runner as
# directly connected to 198.51.100.0/24 (the fake lab network run_test.sh's
# fake govc hands out root/intermediate/fresh addresses on) through a fake
# interface, with a default route on it. FAKE_IP_NO_DEFAULT drops the default
# route, and FAKE_IP_NO_CONNECTED drops the connected route, for the error
# paths network_test.sh covers.
set -euo pipefail

case "$1 $2 $3" in
  "-4 -o route")
    [ -n "${FAKE_IP_NO_CONNECTED:-}" ] || echo "198.51.100.0/24 dev gatenet0 proto kernel scope link src 198.51.100.5"
    [ -n "${FAKE_IP_NO_DEFAULT:-}" ] || echo "default via 198.51.100.1 dev gatenet0 proto dhcp metric 100"
    # A second interface's default route, to prove the gateway lookup is
    # scoped to the connected route's own interface, not just any default.
    echo "default via 203.0.113.1 dev otherlink0 proto dhcp metric 200"
    ;;
  *)
    echo "fake ip: unexpected invocation: $*" >&2
    exit 1
    ;;
esac
